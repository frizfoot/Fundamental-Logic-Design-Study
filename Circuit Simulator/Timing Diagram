# ── 식 파서 (SystemVerilog 연산자) ──────────────────────────────────
#   NOT  : ~a, !a            AND : a & b, a && b      OR  : a | b, a || b
#   XOR  : a ^ b             XNOR: a ~^ b, a ^~ b     같다/다르다: a == b, a != b
#   고르기: c ? a : b         괄호: ( )                상수: 0, 1, 1'b0, 1'b1
#   묶는 차례도 SystemVerilog 그대로입니다: ~ > == != > & > ^ > | > && > || > ?:
class EqError(Exception):
    pass


TOKEN = re.compile(r"""\s*(
      [01]'[bB][01]                      # 1'b0 / 1'b1
    | '[01]                              # '0 / '1
    | [A-Za-z_][A-Za-z_0-9]*             # 이름
    | [01]                               # 0 / 1
    | ~\^ | \^~ | == | != | && | \|\|    # 두 글자 연산자를 먼저
    | [~!&|^()?:]
)""", re.X)

# 불 대수식을 쓰던 분을 위한 길잡이
OLD_OPS = {"+": "OR 는 | 입니다", "*": "AND 는 & 입니다",
           ".": "AND 는 & 입니다", "'": "NOT 은 앞에 붙이는 ~ 입니다"}


def tokenize(src):
    out, i = [], 0
    while i < len(src):
        if src[i].isspace():
            i += 1
            continue
        m = TOKEN.match(src, i)
        if not m:
            hint = OLD_OPS.get(src[i])
            raise EqError("쓸 수 없는 기호: %r%s"
                          % (src[i], "  — " + hint if hint else ""))
        out.append(m.group(1))
        i = m.end()
    return out


class Parser:
    """재귀 하강 파서 -> 튜플 트리. 묶는 차례는 SystemVerilog 를 따릅니다."""

    def __init__(self, src, known=()):
        self.t = tokenize(src)
        self.i = 0

    def peek(self):
        return self.t[self.i] if self.i < len(self.t) else None

    def take(self):
        tok = self.peek()
        self.i += 1
        return tok

    def expect(self, tok):
        if self.take() != tok:
            raise EqError("%r 가 있어야 합니다" % tok)

    def parse(self):
        if not self.t:
            raise EqError("식이 비어 있습니다")
        node = self.p_cond()
        if self.peek() is not None:
            tok = self.peek()
            hint = ("  — 사이에 연산자를 넣으세요(붙여 쓰는 AND 는 없습니다)"
                    if re.match(r"^[A-Za-z_0-9(]", tok) else "")
            raise EqError("식을 끝까지 읽지 못했습니다: %r 부근%s" % (tok, hint))
        return node

    def p_cond(self):                       # c ? a : b
        n = self.p_lor()
        if self.peek() == "?":
            self.take()
            a = self.p_cond()
            self.expect(":")
            return ("mux", n, a, self.p_cond())
        return n

    def p_lor(self):                        # ||
        n = self.p_land()
        while self.peek() == "||":
            self.take()
            n = ("or", n, self.p_land())
        return n

    def p_land(self):                       # &&
        n = self.p_bor()
        while self.peek() == "&&":
            self.take()
            n = ("and", n, self.p_bor())
        return n

    def p_bor(self):                        # |
        n = self.p_bxor()
        while self.peek() == "|":
            self.take()
            n = ("or", n, self.p_bxor())
        return n

    def p_bxor(self):                       # ^  ~^  ^~
        n = self.p_band()
        while self.peek() in ("^", "~^", "^~"):
            op = "xor" if self.take() == "^" else "xnor"
            n = (op, n, self.p_band())
        return n

    def p_band(self):                       # &
        n = self.p_eq()
        while self.peek() == "&":
            self.take()
            n = ("and", n, self.p_eq())
        return n

    def p_eq(self):                         # ==  !=   (1비트에서는 XNOR/XOR)
        n = self.p_unary()
        while self.peek() in ("==", "!="):
            op = "xnor" if self.take() == "==" else "xor"
            n = (op, n, self.p_unary())
        return n

    def p_unary(self):                      # ~a  !a
        if self.peek() in ("~", "!"):
            self.take()
            return ("not", self.p_unary())
        return self.p_atom()

    def p_atom(self):
        tok = self.take()
        if tok is None:
            raise EqError("식이 중간에 끊겼습니다")
        if tok == "(":
            n = self.p_cond()
            self.expect(")")
            return n
        if tok in ("0", "1"):
            return ("const", int(tok))
        if tok[-1] in "01" and ("'" in tok):          # 1'b0 / '1 꼴
            return ("const", int(tok[-1]))
        if re.match(r"^[A-Za-z_]", tok):
            return ("var", tok)
        raise EqError("예상하지 못한 기호: %r" % tok)


def ev3(node, look):
    """0 / 1 / None(모름) 3값 계산. look(name) 도 같은 3값을 돌려줍니다."""
    k = node[0]
    if k == "const":
        return node[1]
    if k == "var":
        return look(node[1])
    if k == "not":
        v = ev3(node[1], look)
        return None if v is None else 1 - v
    if k == "mux":                                  # c ? a : b
        c = ev3(node[1], look)
        if c is not None:
            return ev3(node[2] if c else node[3], look)
        a, b = ev3(node[2], look), ev3(node[3], look)
        return a if a is not None and a == b else None   # 두 쪽이 같으면 정해집니다
    a, b = ev3(node[1], look), ev3(node[2], look)
    if k == "and":
        if a == 0 or b == 0:          # 한쪽이 0이면 나머지는 몰라도 0
            return 0
        return None if a is None or b is None else a & b
    if k == "or":
        if a == 1 or b == 1:          # 한쪽이 1이면 나머지는 몰라도 1
            return 1
        return None if a is None or b is None else a | b
    if a is None or b is None:
        return None
    return (a ^ b) if k == "xor" else 1 - (a ^ b)


def used_names(node, acc=None):
    acc = set() if acc is None else acc
    if node[0] == "var":
        acc.add(node[1])
    elif node[0] in ("and", "or", "xor", "xnor"):
        used_names(node[1], acc)
        used_names(node[2], acc)
    elif node[0] == "not":
        used_names(node[1], acc)
    elif node[0] == "mux":
        for q in node[1:]:
            used_names(q, acc)
    return acc


# ── 상태 ─────────────────────────────────────────────────────────────
class State:
    def __init__(self):
        self.steps = 24
        self.cellw = 30
        self.unit = ""
        self.title = "타이밍 다이어그램"
        self.show_grid = True
        self.show_values = True   # 칸마다 0/1 표시
        self.edge_line = ""       # 클럭 에지 점선: "" / rise / fall / both
        self.img = None          # PIL.Image 또는 tk.PhotoImage 원본
        self.img_path = ""
        self.img_scale = 70
        self.cursor = None
        self._ast_cache = {}     # 식 문자열 -> (트리, 오류문구)
        self._seq = {}           # 순차 노드 -> 칸별로 푼 값
        self._solved = False
        self.signals = self.seed()

    def seed(self):
        H = [1 if i <= 8 else 0 if i <= 10 else 1 if i <= 19 else 0 if i <= 21 else 1
             for i in range(24)]
        V = [0 if i == 0 else 1 for i in range(24)]
        return [
            dict(name="clock", type="clk", period=2, inv=False, values=[], labels=[]),
            dict(name="Hsync", type="sig", period=2, inv=False, values=H,
                 labels=[dict(s=0, e=8, text="H_1line"), dict(s=11, e=19, text="H_2line")]),
            dict(name="Vsync", type="sig", period=2, inv=False, values=V,
                 labels=[dict(s=1, e=20, text="V_1line")]),
            dict(name="disp", type="eq", period=2, inv=False, expr="Hsync & Vsync",
                 values=[], labels=[]),
        ]

    def seed_seq(self):
        """순차 회로 예제: 입력 X, 상태 A, 출력 Z(Mealy) / Y(Moore)."""
        self.__init__()
        self.title = "순차 회로 타이밍"
        X = [0] * 4 + [1] * 8 + [0] * 4 + [1] * 8
        self.signals = [
            dict(name="clock", type="clk", period=4, inv=False, expr="",
                 values=[], labels=[]),
            dict(name="X", type="sig", period=2, inv=False, expr="",
                 values=X[:self.steps], labels=[]),
            dict(name="A", type="seq", period=2, inv=False, expr="A ^ X",
                 clk="clock", edge="rise", init=0, values=[], labels=[]),
            dict(name="Z", type="eq", period=2, inv=False, expr="A & X",
                 values=[], labels=[]),
            dict(name="Y", type="eq", period=2, inv=False, expr="~A",
                 values=[], labels=[]),
        ]

    def blank(self):
        """빈 문서(클럭 1줄 + 신호 1줄)로 되돌립니다."""
        self.__init__()
        self.signals = [
            dict(name="clock", type="clk", period=2, inv=False, values=[], labels=[]),
            dict(name="node1", type="sig", period=2, inv=False,
                 values=[0] * self.steps, labels=[]),
        ]

    # 값 읽기
    def val(self, sig, i):
        """그리기용 0/1. 계산할 수 없으면 0으로 둡니다."""
        v = self.val3(sig, i)
        return 0 if v is None else v

    def raw(self, sig, i):
        """손으로 찍은 칸 그대로(0 / 1 / "F")."""
        vs = sig.get("values") or []
        return vs[i] if i < len(vs) else 0

    def cell_text(self, sig, i):
        """칸에 적을 글자: 0 / 1 / F / ?"""
        if sig.get("type") == "sig" and self.raw(sig, i) == FALSE:
            return FALSE
        v = self.val3(sig, i)
        return "?" if v is None else ("1" if v else "0")

    def val3(self, sig, i, seen=()):
        """0 / 1 / None(정보가 모자람)."""
        t = sig.get("type", "sig")
        if t == "clk":
            p = max(2, int(sig.get("period", 2)))
            hi = 1 if ((i - int(sig.get("phase", 0))) % p) >= p / 2 else 0
            return 1 - hi if sig.get("inv") else hi
        if t == "eq":
            return self._eval_eq(sig, i, seen)
        if t == "seq":
            self.solve()
            ser = self._seq.get(id(sig))
            return ser[i] if ser is not None and i < len(ser) else None
        v = self.raw(sig, i)
        return 0 if v == FALSE else v

    def _eval_eq(self, sig, i, seen=()):
        if sig["name"] in seen:          # 서로 물고 도는 식
            return None
        node, _err = self.ast_of(sig)
        if node is None:
            return None
        seen = seen + (sig["name"],)
        return ev3(node, lambda nm: self._look(nm, i, sig, seen))

    def find(self, name, me=None, allow_self=False):
        """이름으로 노드를 찾습니다. 같은 회로 것을 먼저 봅니다."""
        def ok(s):
            return s["name"] == name and (allow_self or s is not me)
        if me is not None:
            mine = me.get("group", "")
            same = [s for s in self.signals
                    if s["name"] == name and s.get("group", "") == mine]
            if same:            # 제 회로에 그 이름이 있으면 남의 회로는 안 봅니다
                return next((s for s in same if ok(s)), None)
        return next((s for s in self.signals if ok(s)), None)

    def _look(self, name, i, me, seen, allow_self=False):
        src = self.find(name, me, allow_self)
        return None if src is None else self.val3(src, i, seen)

    # ── 순차(클럭에 물린) 노드 ──
    def invalidate(self):
        """값이 바뀌었으니 풀어 둔 순차 값을 버립니다."""
        self._seq = {}
        self._solved = False

    def clock_of(self, sig):
        """그 노드를 움직이는 클럭 노드.

        따로 고른 클럭이 있으면 그것을, 없거나 사라졌으면 맨 위 클럭을 씁니다.
        """
        nm = sig.get("clk", "")
        if nm:
            got = self.find(nm, sig)
            if got is not None:
                return got
        mine = sig.get("group", "")
        return (next((s for s in self.signals if s.get("type") == "clk"
                      and s is not sig and s.get("group", "") == mine), None) or
                next((s for s in self.signals if s.get("type") == "clk"
                      and s is not sig), None))

    def edge_at(self, sig, i):
        """i 칸으로 넘어오면서 활성 에지가 있었는지."""
        ck = self.clock_of(sig)
        if ck is None or i <= 0:
            return None if ck is None else False
        a, b = self.val3(ck, i - 1), self.val3(ck, i)
        if a is None or b is None:
            return None
        return (a, b) == ((0, 1) if sig.get("edge", "rise") == "rise" else (1, 0))

    def solve(self):
        """순차 노드를 0번 칸부터 한 칸씩, 다 같이 풀어 둡니다."""
        if self._solved:
            return
        self._solved = True                      # 푸는 중의 되돌이 호출을 막습니다
        seqs = [s for s in self.signals if s.get("type") == "seq"]
        if not seqs:
            return
        self._seq = {id(s): [None] * self.steps for s in seqs}
        for i in range(self.steps):
            for s in seqs:
                self._seq[id(s)][i] = self._seq_step(s, i)

    def _seq_step(self, sig, i):
        if self.clock_of(sig) is None:           # 클럭이 없으면 알 수 없습니다
            return None
        if i == 0:
            return 1 if sig.get("init") else 0
        prev = self._seq[id(sig)][i - 1]
        hit = self.edge_at(sig, i)
        if hit is None:
            return None
        if not hit:
            return prev                          # 에지가 아니면 그대로 붙듭니다
        node, _err = self.ast_of(sig)
        if node is None:
            return None
        # 에지 바로 앞 칸의 값으로 다음 값을 정합니다
        return ev3(node, lambda nm: self._look(nm, i - 1, sig, (), True))

    def ast_of(self, sig):
        """식을 파싱해 (트리, 오류문구)를 돌려줍니다. 결과는 캐시합니다."""
        expr = (sig.get("expr") or "").strip()
        if not expr:
            return None, "식이 비어 있습니다"
        key = expr
        if key not in self._ast_cache:
            if len(self._ast_cache) > 256:
                self._ast_cache.clear()
            try:
                self._ast_cache[key] = (Parser(expr).parse(), "")
            except EqError as ex:
                self._ast_cache[key] = (None, str(ex))
            except Exception as ex:                    # 파서가 놓친 경우까지
                self._ast_cache[key] = (None, "읽을 수 없는 식: %s" % ex)
        return self._ast_cache[key]

    def refs_of(self, sig):
        """그 식이 가리키는 노드들."""
        node, _err = self.ast_of(sig)
        if node is None:
            return []
        out = []
        for nm in sorted(used_names(node)):
            src = next((s for s in self.signals if s["name"] == nm), None)
            if src is not None:
                out.append(src)
        return out

    def kind_of(self, sig):
        """조합식이 상태에 물려 있으면 Moore / Mealy 를 가려 줍니다."""
        if sig.get("type") != "eq":
            return ""
        refs = self.refs_of(sig)
        st_refs = [s for s in refs if s.get("type") == "seq"]
        in_refs = [s for s in refs if s.get("type") == "sig"]
        if not st_refs:
            return ""
        return "Mealy 출력(상태+입력)" if in_refs else "Moore 출력(상태만)"

    def eq_error(self, sig):
        """식 노드의 상태 문구(빈 문자열이면 정상)."""
        t = sig.get("type")
        if t not in ("eq", "seq"):
            return ""
        self.invalidate()
        if t == "seq" and self.clock_of(sig) is None:
            nm = sig.get("clk", "")
            return ("클럭을 찾을 수 없습니다: %s" % nm) if nm else                    "클럭 노드가 없습니다 — 클럭을 고르세요"
        node, err = self.ast_of(sig)
        if node is None:
            return err
        missing = sorted(nm for nm in used_names(node)
                         if self.find(nm, sig, t == "seq") is None)
        if missing:
            return "모르는 이름: %s" % ", ".join(missing)
        if any(self.val3(sig, i) is None for i in range(self.steps)):
            return "정보가 모자란 칸은 ?로 둡니다"
        if t == "seq":
            ck = self.clock_of(sig)
            return "%s %s 에지마다 바로 앞 값으로 바뀝니다" % (
                ck["name"], "↑" if sig.get("edge", "rise") == "rise" else "↓")
        return self.kind_of(sig) or "식대로 계산했습니다"

    def rename(self, r, new):
        """노드 이름을 바꾸고, 그 이름을 쓰던 식도 따라 고칩니다."""
        old = self.signals[r]["name"]
        new = (new or "").strip()[:16]
        if not new or new == old:
            return False
        mine = self.signals[r].get("group", "")
        kin = [sg for sg in self.signals if sg.get("group", "") == mine]
        self.signals[r]["name"] = new
        for sg in kin:                           # 클럭으로 가리키던 곳도 함께
            if sg.get("clk") == old:
                sg["clk"] = new
        if re.match(r"^[A-Za-z_][A-Za-z_0-9]*$", old):
            pat = re.compile(r"(?<![A-Za-z_0-9])%s(?![A-Za-z_0-9])" % re.escape(old))
            for sg in kin:                       # 같은 회로의 식만 고칩니다
                if sg.get("type") in ("eq", "seq") and (sg.get("expr") or "").strip():
                    sg["expr"] = pat.sub(new, sg["expr"])
        self._ast_cache.clear()
        self.invalidate()
        return True

    def set_val(self, row, i, v):
        sig = self.signals[row]
        if sig["type"] in ("clk", "eq", "seq"):
            return
        self.invalidate()
        vs = sig["values"]
        if len(vs) < self.steps:
            vs.extend([0] * (self.steps - len(vs)))
        vs[i] = v

    # ── 회로(그룹) ──
    def blocks(self):
        """이어진 줄끼리 회로 묶음으로 나눕니다 -> [(이름, [줄 번호]), ...]."""
        out = []
        for i, g in enumerate(self.signals):
            nm = g.get("group", "")
            if out and out[-1][0] == nm:
                out[-1][1].append(i)
            else:
                out.append((nm, [i]))
        return out

    def group_names(self):
        seen = []
        for g in self.signals:
            nm = g.get("group", "")
            if nm not in seen:
                seen.append(nm)
        return seen

    def rows_of(self, name):
        return [i for i, g in enumerate(self.signals)
                if g.get("group", "") == name]

    def row_at(self, y):
        """그 y 자리에 있는 줄 번호. 없으면 None."""
        for r, top in self.layout()[0].items():
            if top <= y < top + ROW:
                return r
        return None

    def layout(self):
        """(줄 -> y, [(회로 이름, y), ...], 전체 높이)."""
        tops, heads, y = {}, [], self.chart_top
        for nm, idx in self.blocks():
            if nm:
                heads.append((nm, y))
                y += GROUP_H
            for r in idx:
                tops[r] = y
                y += ROW
        return tops, heads, y - self.chart_top

    # 도형 좌표
    @property
    def chart_x(self):
        return PAD + GUT

    @property
    def chart_w(self):
        return self.steps * self.cellw

    def img_box(self):
        if self.img is None:
            return 0, 0
        w = int((GUT + self.chart_w) * self.img_scale / 100)
        iw, ih = self.img.size if HAS_PIL else (self.img.width(), self.img.height())
        h = max(1, int(w * ih / iw))
        return w, h

    @property
    def chart_top(self):
        _, h = self.img_box()
        return PAD + (h + IMG_GAP if self.img is not None else 0) + 14

    @property
    def chart_h(self):
        return self.layout()[2]

    def row_top(self, r):
        return self.layout()[0].get(r, self.chart_top + r * ROW)

    def y_mid(self, r):
        return self.row_top(r) + ROW / 2

    @property
    def total_w(self):
        return PAD * 2 + GUT + self.chart_w

    @property
    def total_h(self):
        return self.chart_top + self.chart_h + AXIS + PAD

    def clock_edges(self, kind=None, ck=None):
        """클럭이 바뀌는 칸 번호. kind: rise / fall / both."""
        kind = self.edge_line if kind is None else kind
        if not kind:
            return []
        if ck is None:
            ck = next((g for g in self.signals if g.get("type") == "clk"), None)
        if ck is None:
            return []
        out = []
        for i in range(1, self.steps):
            a, b = self.val3(ck, i - 1), self.val3(ck, i)
            if a is None or b is None:
                continue
            if (a, b) == (0, 1) and kind in ("rise", "both"):
                out.append(i)
            elif (a, b) == (1, 0) and kind in ("fall", "both"):
                out.append(i)
        return out

    def tick_every(self):
        need = -(-26 // self.cellw)
        for n in (1, 2, 5, 10, 20):
            if n >= need:
                return n
        return 25

    # 저장 / 복원
    def to_dict(self):
        return dict(steps=self.steps, cellw=self.cellw, unit=self.unit, title=self.title,
                    show_grid=self.show_grid, show_values=self.show_values,
                    edge_line=self.edge_line, img_path=self.img_path,
                    img_scale=self.img_scale, signals=self.signals)

    def from_dict(self, d):
        self.steps = d.get("steps", 24)
        self.cellw = d.get("cellw", 30)
        self.unit = d.get("unit", "")
        self.title = d.get("title", "타이밍 다이어그램")
        self.show_grid = d.get("show_grid", True)
        self.show_values = d.get("show_values", True)
        self.edge_line = d.get("edge_line", "")
        self.img_scale = d.get("img_scale", 70)
        self.signals = d.get("signals", self.seed())
        for sg in self.signals:                     # 옛 파일에는 없던 칸들
            sg.setdefault("expr", "")
            sg.setdefault("labels", [])
            sg.setdefault("values", [])
            sg.setdefault("clk", "")
            sg.setdefault("edge", "rise")
            sg.setdefault("init", 0)
            sg.setdefault("phase", 0)
            sg.setdefault("group", "")
        self.invalidate()
        self._ast_cache.clear()
        self.img_path = d.get("img_path", "")


# ── 렌더링 백엔드 ────────────────────────────────────────────────────
class TkBackend:
    """tkinter Canvas에 그립니다."""

    def __init__(self, canvas, tag=None):
        self.c = canvas
        self.tag = (tag,) if tag else ()

    def line(self, x1, y1, x2, y2, color=INK, width=1, dash=None):
        self.c.create_line(x1, y1, x2, y2, fill=color, width=width,
                           dash=dash, tags=self.tag)

    def path(self, pts, color=INK, width=2):
        flat = [v for p in pts for v in p]
        self.c.create_line(*flat, fill=color, width=width, tags=self.tag)

    def rect(self, x1, y1, x2, y2, fill="", outline="", dash=None):
        self.c.create_rectangle(x1, y1, x2, y2, fill=fill, outline=outline,
                                dash=dash, tags=self.tag)

    def polygon(self, pts, fill=INK, outline=""):
        flat = [v for q in pts for v in q]
        self.c.create_polygon(*flat, fill=fill, outline=outline, tags=self.tag)

    def polyline(self, pts, color=INK, width=2, dash=None):
        flat = [v for q in pts for v in q]
        self.c.create_line(*flat, fill=color, width=width, dash=dash, tags=self.tag)

    def ellipse(self, x1, y1, x2, y2, fill="", outline=INK, width=2, dash=None):
        self.c.create_oval(x1, y1, x2, y2, fill=fill, outline=outline,
                           width=width, dash=dash, tags=self.tag)

    def text(self, x, y, s, color=INK, size=12, anchor="w", bold=False):
        a = {"w": "w", "e": "e", "c": "center"}[anchor]
        self.c.create_text(x, y, text=s, fill=color, anchor=a, tags=self.tag,
                           font=(MONO, size, "bold" if bold else "normal"))

    def image(self, x, y, w, h, img):
        self.c.create_image(x, y, image=img, anchor="nw", tags=self.tag)


class PilBackend:
    """Pillow 이미지에 그립니다(PNG 내보내기용)."""

    def __init__(self, im, scale=2):
        self.d = ImageDraw.Draw(im)
        self.im = im
        self.k = scale
        self._fonts = {}

    def _font(self, size, bold, cjk=False):
        key = (size, bold, cjk)
        if key not in self._fonts:
            f = None
            for cand in (CJK_CANDIDATES if cjk else []) + FONT_CANDIDATES:
                try:
                    f = ImageFont.truetype(cand, int(size * self.k))
                    break
                except Exception:
                    continue
            self._fonts[key] = f or ImageFont.load_default()
        return self._fonts[key]

    def line(self, x1, y1, x2, y2, color=INK, width=1, dash=None):
        k = self.k
        self.d.line([x1 * k, y1 * k, x2 * k, y2 * k], fill=color, width=max(1, int(width * k)))

    def path(self, pts, color=INK, width=2):
        k = self.k
        self.d.line([(x * k, y * k) for x, y in pts], fill=color,
                    width=max(1, int(width * k)), joint="curve")

    def rect(self, x1, y1, x2, y2, fill="", outline="", dash=None):
        k = self.k
        self.d.rectangle([x1 * k, y1 * k, x2 * k, y2 * k],
                         fill=fill or None, outline=outline or None)

    def polygon(self, pts, fill=INK, outline=""):
        k = self.k
        self.d.polygon([(x * k, y * k) for x, y in pts],
                       fill=fill or None, outline=outline or None)

    def polyline(self, pts, color=INK, width=2, dash=None):
        k = self.k
        self.d.line([(x * k, y * k) for x, y in pts], fill=color,
                    width=max(1, int(width * k)), joint="curve")

    def ellipse(self, x1, y1, x2, y2, fill="", outline=INK, width=2, dash=None):
        k = self.k
        self.d.ellipse([x1 * k, y1 * k, x2 * k, y2 * k], fill=fill or None,
                       outline=outline or None, width=max(1, int(width * k)))

    def text(self, x, y, s, color=INK, size=12, anchor="w", bold=False):
        k = self.k
        a = {"w": "lm", "e": "rm", "c": "mm"}[anchor]
        self.d.text((x * k, y * k), s, fill=color, anchor=a,
                    font=self._font(size, bold, has_cjk(s)))

    def image(self, x, y, w, h, img):
        k = self.k
        self.im.paste(img.resize((int(w * k), int(h * k))), (int(x * k), int(y * k)))


# ── 장면 그리기(두 백엔드 공통) ──────────────────────────────────────
def dashed_v(be, x, y1, y2, color=EDGELINE, width=1, on=4, off=4):
    """세로 점선. PNG 로 내보내도 같은 모양이 되도록 토막으로 긋습니다."""
    y = y1
    while y < y2:
        be.line(x, y, x, min(y + on, y2), color=color, width=width)
        y += on + off


def draw_scene(be, st, tk_img=None, with_cursor=True, preview=None):
    st.invalidate()                     # 늘 지금 값으로 다시 풉니다
    be.rect(0, 0, st.total_w, st.total_h, fill=PAPER)

    if st.img is not None:
        w, h = st.img_box()
        be.image(PAD, PAD, w, h, tk_img if tk_img is not None else st.img)

    cx, cw = st.chart_x, st.cellw
    top, ch = st.chart_top, st.chart_h

    if st.show_grid:
        spans = [(st.row_top(idx[0]) - 6, st.row_top(idx[-1]) + ROW - 6)
                 for _nm, idx in st.blocks()] or [(top - 8, top + ch + 6)]
        spans[0] = (min(spans[0][0], top - 8), spans[0][1])
        spans[-1] = (spans[-1][0], max(spans[-1][1], top + ch + 6))
        for i in range(st.steps + 1):
            x = cx + i * cw
            col = GRID_MAJOR if i % 5 == 0 else GRID
            for y1, y2 in spans:
                be.line(x, y1, x, y2, color=col)

    tops, heads, _ = st.layout()
    for nm, y in heads:                    # 회로 제목과 가르는 줄
        be.line(cx - GUT + 6, y + GROUP_H - 7, cx + st.chart_w,
                y + GROUP_H - 7, color=LINE)
        be.text(cx - GUT + 6, y + 8, nm, color=ACCENT, size=11, anchor="w",
                bold=True)

    for nm, idx in st.blocks():            # 회로마다 제 클럭으로 에지 점선
        if not st.edge_line or not idx:
            break
        ck = next((st.signals[r] for r in idx
                   if st.signals[r].get("type") == "clk"), None)
        if ck is None:
            ck = st.clock_of(st.signals[idx[0]])
        y1 = tops[idx[0]] - 6
        y2 = tops[idx[-1]] + ROW - 6
        for i in st.clock_edges(ck=ck):
            dashed_v(be, cx + i * cw, y1, y2)

    # 노드
    for r, sig in enumerate(st.signals):
        ym = st.y_mid(r)
        y_hi, y_lo = ym - AMP, ym + AMP
        nm = sig["name"]
        ns = 12 if len(nm) <= 11 else (10 if len(nm) <= 14 else 9)   # 긴 이름도 여백 안에
        be.text(cx - 34, ym, nm, color=INK, size=ns, anchor="e", bold=True)
        if sig.get("type") == "seq":          # 값을 집는 에지 자리
            up = sig.get("edge", "rise") == "rise"
            ytop = st.row_top(r) + 4
            for i in range(1, st.steps):
                if not st.edge_at(sig, i):
                    continue
                x = cx + i * cw
                be.polygon([(x, ytop), (x - 4, ytop + 7), (x + 4, ytop + 7)] if up
                           else [(x - 4, ytop), (x + 4, ytop), (x, ytop + 7)],
                           fill=EDGEMARK)

        if sig.get("type") in ("eq", "seq") and (sig.get("expr") or "").strip():
            ex = sig["expr"].strip()
            if len(ex) > 11:                  # 왼쪽 여백 안에 들어오게
                ex = ex[:10] + "…"
            mark = "=" if sig["type"] == "eq" else (
                "↑=" if sig.get("edge", "rise") == "rise" else "↓=")
            be.text(cx - 34, ym + 14, "%s %s" % (mark, ex),
                    color=MUTED, size=9, anchor="e")

        pts = []
        y_prev = y_lo if st.val(sig, 0) == 0 else y_hi
        pts.append((cx, y_prev))
        for i in range(1, st.steps):
            y_cur = y_lo if st.val(sig, i) == 0 else y_hi
            if y_cur != y_prev:
                x = cx + i * cw
                pts.append((x, y_prev))
                pts.append((x, y_cur))
                y_prev = y_cur
        pts.append((cx + st.chart_w, y_prev))
        be.path(pts, color=INK, width=2)

        if st.show_values:
            fs = 9 if st.cellw < 22 else 10
            yv = st.row_top(r) + ROW - 7          # 파형 아래쪽 줄에 가지런히 표시
            for i in range(st.steps):
                txt = st.cell_text(sig, i)
                be.text(cx + (i + 0.5) * cw, yv, txt,
                        color=UNKNOWN if txt == "?" else VALUE,
                        size=fs, anchor="c", bold=True)

        for lb in sig["labels"]:
            mx = cx + ((lb["s"] + lb["e"] + 1) / 2) * cw
            be.text(mx, ym, lb["text"], color=INK, size=11, anchor="c")

    # 시간축
    be.line(cx, top + ch + 6, cx + st.chart_w, top + ch + 6, color=LINE)
    te = st.tick_every()
    for i in range(st.steps + 1):
        if i % te and i != st.steps:
            continue
        x = cx + i * cw
        be.line(x, top + ch + 6, x, top + ch + 11, color=GRID_MAJOR)
        be.text(x, top + ch + 20, str(i), color=MUTED, size=9, anchor="c")
    if st.unit:
        be.text(cx + st.chart_w + 10, top + ch + 20, "[%s]" % st.unit,
                color=MUTED, size=9, anchor="w")

    if preview:
        r, s, e = preview
        be.rect(cx + s * cw, st.row_top(r) + 10, cx + (e + 1) * cw,
                st.row_top(r) + ROW - 10, outline=ACCENT, dash=(4, 3))


# ── 줄 손잡이 / 선택 표시(화면 전용, PNG에는 안 들어갑니다) ─────────
HANDLE_X, HANDLE_W, HANDLE_H = 14, 15, 13


def handle_boxes(st, r):
    """그 줄의 (▲상자, ▼상자) 좌표."""
    ym = st.y_mid(r)
    x1, x2 = HANDLE_X - HANDLE_W / 2, HANDLE_X + HANDLE_W / 2
    return ((x1, ym - 2 - HANDLE_H, x2, ym - 2),
            (x1, ym + 2, x2, ym + 2 + HANDLE_H))


def in_box(box, x, y):
    x1, y1, x2, y2 = box
    return x1 <= x <= x2 and y1 <= y <= y2


def draw_row_tools(be, st, sel=None, hot=None):
    """고른 줄 표시와 ▲▼ 손잡이를 그립니다."""
    last = len(st.signals) - 1
    if sel is not None and 0 <= sel <= last:
        be.rect(2, st.row_top(sel) + 6, 5, st.row_top(sel) + ROW - 6,
                fill=ACCENT, outline="")
    for r in sorted({q for q in (sel, hot) if q is not None and 0 <= q <= last}):
        for box, d in zip(handle_boxes(st, r), (-1, 1)):
            x1, y1, x2, y2 = box
            be.rect(x1, y1, x2, y2, fill=PAPER, outline=LINE)
            xm, g = (x1 + x2) / 2, 3.5
            pts = ([(xm, y1 + g), (x1 + g, y2 - g), (x2 - g, y2 - g)] if d < 0
                   else [(x1 + g, y1 + g), (x2 - g, y1 + g), (xm, y2 - g)])
            be.polygon(pts, fill=ACCENT if 0 <= r + d <= last else LINE)


def draw_cursor(be, st):
    if st.cursor is None:
        return
    cx, cw = st.chart_x, st.cellw
    x = cx + st.cursor * cw
    be.line(x, st.chart_top - 16, x, st.chart_top + st.chart_h + 6,
            color=ACCENT, dash=(3, 3))
    be.line(x + cw, st.chart_top - 8, x + cw, st.chart_top + st.chart_h + 6,
            color=ACCENT, dash=(3, 3))
    be.text(x + 4, st.chart_top - 22, "t=%d" % st.cursor, color=ACCENT, size=10, bold=True)
    for r, sig in enumerate(st.signals):
        txt = st.cell_text(sig, st.cursor)
        txt = {"0": "L", "1": "H"}.get(txt, txt)
        be.text(cx - 12, st.y_mid(r), txt,
                color=UNKNOWN if txt == "?" else ACCENT,
                size=11, anchor="e", bold=True)


# ── 노드에서 뽑아낸 상태 기계 ────────────────────────────────────────
class FsmError(Exception):
    pass


class Fsm:
    """타이밍 노드를 그대로 읽어 상태 기계로 봅니다.

    순차식 노드 = 상태 변수, 그 식에 쓰인 신호 노드 = 입력,
    조합식 노드 = 출력. 처음 상태는 각 순차식의 [처음값] 입니다.
    """

    def __init__(self, st, group=None):
        self.st = st
        self.group = group
        sigs = [g for g in st.signals
                if group is None or g.get("group", "") == group]
        self.sigs = sigs
        self.S = [g for g in sigs if g.get("type") == "seq"]
        self.O = [g for g in sigs if g.get("type") == "eq"]
        if not self.S:
            raise FsmError("순차식 노드가 없습니다 — 상태 변수를 만들어 주세요")
        if len(self.S) > 6:
            raise FsmError("상태 변수는 6개까지입니다 (지금 %d개)" % len(self.S))

        self.trees = {}
        for g in self.S + self.O:
            tree, err = st.ast_of(g)
            if tree is None:
                raise FsmError("%s%s 의 식을 읽을 수 없습니다: %s"
                               % ("[%s] " % group if group else "", g["name"], err))
            self.trees[g["name"]] = tree

        used = set()
        for t in self.trees.values():
            used |= used_names(t)
        self.X = [g for g in sigs
                  if g.get("type") == "sig" and g["name"] in used]
        if len(self.X) > 5:
            raise FsmError("입력은 5개까지입니다 (지금 %d개)" % len(self.X))

        self.snames = [g["name"] for g in self.S]
        self.xnames = [g["name"] for g in self.X]
        self.onames = [g["name"] for g in self.O]
        miss = sorted(used - set(self.snames) - set(self.xnames) - set(self.onames))
        if miss:
            raise FsmError("%s 안에 %s 이(가) 없습니다"
                           % ("[%s]" % group if group else "이 회로",
                              ", ".join(miss)))

        self.n, self.m = len(self.S), len(self.X)
        self.states = [tuple(b) for b in itertools.product((0, 1), repeat=self.n)]
        self.ins = ([tuple(b) for b in itertools.product((0, 1), repeat=self.m)]
                    if self.m else [()])
        self.mealy = any(used_names(self.trees[nm]) & set(self.xnames)
                         for nm in self.onames)
        self.start = tuple(1 if g.get("init") else 0 for g in self.S)
        self.rows = self._build()
        self.reach = self._reachable()

    # ── 계산 ──
    def _look(self, nm, env, seen=()):
        if nm in env:
            return env[nm]
        if nm in self.trees and nm not in seen:        # 조합식은 풀어서 씁니다
            return ev3(self.trees[nm],
                       lambda k: self._look(k, env, seen + (nm,)))
        return None

    def _val(self, nm, env):
        v = ev3(self.trees[nm], lambda k: self._look(k, env))
        if v is None:
            raise FsmError("%s 의 값을 정할 수 없습니다 (식을 확인해 주세요)" % nm)
        return v

    def env_of(self, cur, xi):
        e = dict(zip(self.snames, cur))
        e.update(zip(self.xnames, xi))
        return e

    def next_of(self, cur, xi):
        e = self.env_of(cur, xi)
        return tuple(self._val(nm, e) for nm in self.snames)

    def out_of(self, cur, xi):
        e = self.env_of(cur, xi)
        return [(nm, self._val(nm, e)) for nm in self.onames]

    def _build(self):
        return [dict(cur=c, x=xi, nxt=self.next_of(c, xi), out=self.out_of(c, xi))
                for c in self.states for xi in self.ins]

    def _reachable(self):
        seen, stack = {self.start}, [self.start]
        while stack:
            cur = stack.pop()
            for xi in self.ins:
                nx = self.next_of(cur, xi)
                if nx not in seen:
                    seen.add(nx)
                    stack.append(nx)
        return seen

    # ── 표시 ──
    def sname(self, stt):
        return "".join(str(b) for b in stt)

    def out_str(self, outs):
        return "".join(str(v) for _, v in outs)

    def edges(self):
        agg = {}
        for r in self.rows:
            xs = "".join(str(b) for b in r["x"]) if r["x"] else ""
            lab = "%s/%s" % (xs, self.out_str(r["out"])) if self.mealy else xs
            agg.setdefault((r["cur"], r["nxt"]), []).append(lab)
        return agg

    def node_label(self, stt):
        if self.mealy or not self.O:
            return self.sname(stt)
        return "%s/%s" % (self.sname(stt), self.out_str(self.out_of(stt, self.ins[0])))

    def summary(self):
        un = len(self.states) - len(self.reach)
        return "%s상태 %d개(%s) · 입력 %s · %s%s" % (
            "[%s] " % self.group if self.group else "",
            len(self.states), " ".join(self.snames),
            " ".join(self.xnames) or "없음",
            "Mealy" if self.mealy else "Moore",
            " · 갈 수 없는 상태 %d개" % un if un else "")

    def table_text(self):
        """교과서 꼴 상태표: 상태마다 한 줄, 입력은 열로 펼칩니다.

                 \u2502   A\u207aB\u207aC\u207a   \u2502     Z
          ABC    \u2502 X=0    X=1  \u2502 X=0   X=1
         \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
          000    \u2502 011    010  \u2502  1     0
        """
        ins = self.ins

        def xhead(xi):
            if not self.xnames:
                return ""
            return "%s=%s" % ("".join(self.xnames), "".join(str(b) for b in xi))

        def pack(title, cols):
            """입력을 바꿔도 값이 같으면 한 칸으로 합칩니다(Moore 출력 등)."""
            if len(cols) > 1 and all(q == cols[0] for q in cols[1:]):
                return title, [cols[0]], [""]
            return title, cols, [xhead(xi) for xi in ins]

        # 그룹: 다음 상태 하나 + 출력마다 하나. 그룹 안에서 입력 조합마다 한 열.
        groups = [pack("".join(nm + "\u207a" for nm in self.snames),
                       [[self.sname(self.next_of(c, xi)) for c in self.states]
                        for xi in ins])]
        for k, nm in enumerate(self.onames):
            groups.append(pack(nm, [[str(self.out_of(c, xi)[k][1])
                                     for c in self.states] for xi in ins]))

        left = "".join(self.snames)
        col0 = [self.sname(c) for c in self.states]
        w0 = max([len(left)] + [len(v) for v in col0]) + 2
        gw = [[max([len(labs[j])] + [len(v) for v in cols[j]]) + 2
               for j in range(len(cols))] for _, cols, labs in groups]
        full = [sum(w) + len(w) - 1 for w in gw]

        def join(c0, cells):
            return "\u2502".join([c0.center(w0)] +
                                 [" ".join(cells[i][j].center(gw[i][j])
                                           for j in range(len(gw[i])))
                                  for i in range(len(groups))])

        lines = ["\u2502".join([" " * w0] +
                               [t.center(full[i])
                                for i, (t, _, _) in enumerate(groups)]),
                 join(left, [labs for _, _, labs in groups]),
                 "\u253c".join(["\u2500" * w0] +
                               ["\u2500" * full[i] for i in range(len(groups))])]
        for r in range(len(self.states)):
            lines.append(join(col0[r], [[cols[j][r] for j in range(len(cols))]
                                        for _, cols, _ in groups]))

        un = [self.sname(q) for q in self.states if q not in self.reach]
        return "\n".join(lines + [
            "",
            "형식: " + ("Mealy (출력이 입력에 따라 바뀜)" if self.mealy
                        else "Moore (출력이 상태에만 달림)"),
            "처음 상태: " + self.sname(self.start),
            "갈 수 없는 상태: " + (", ".join(un) if un else "없음")])


# ── 상태 천이도 그리기 ───────────────────────────────────────────────
def qbez(p0, p1, p2, n=26):
    return [((1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * p1[0] + t * t * p2[0],
             (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * p1[1] + t * t * p2[1])
            for t in (i / n for i in range(n + 1))]


def cbez(p0, p1, p2, p3, n=30):
    out = []
    for i in range(n + 1):
        t = i / n
        u = 1 - t
        out.append((u ** 3 * p0[0] + 3 * u * u * t * p1[0]
                    + 3 * u * t * t * p2[0] + t ** 3 * p3[0],
                    u ** 3 * p0[1] + 3 * u * u * t * p1[1]
                    + 3 * u * t * t * p2[1] + t ** 3 * p3[1]))
    return out


def arrow_head(pts, size=9):
    (x1, y1), (x2, y2) = pts[-2], pts[-1]
    a = math.atan2(y2 - y1, x2 - x1)
    return [(x2, y2),
            (x2 - size * math.cos(a - 0.42), y2 - size * math.sin(a - 0.42)),
            (x2 - size * math.cos(a + 0.42), y2 - size * math.sin(a + 0.42))]


def graph_size(fsm):
    r = max(120, len(fsm.states) * 2.9 * NODE_R / (2 * math.pi))
    q = int(2 * (r + NODE_R + 70))
    return max(640, q), max(520, q)


def graph_layout(fsm, W, H):
    n = len(fsm.states)
    cx, cy = W / 2, H / 2
    if n == 1:
        return {fsm.states[0]: (cx, cy)}
    R = min(max(120, n * 2.9 * NODE_R / (2 * math.pi)),
            min(W, H) / 2 - NODE_R - 62)
    return {q: (cx + R * math.cos(-math.pi / 2 + 2 * math.pi * i / n),
                cy + R * math.sin(-math.pi / 2 + 2 * math.pi * i / n))
            for i, q in enumerate(fsm.states)}


def draw_graph(be, fsm, W, H, title="", subtitle=""):
    be.rect(0, 0, W, H, fill=PAPER)
    pos = graph_layout(fsm, W, H)
    if title:
        be.text(W / 2, 24, title, color=INK, size=13, anchor="c", bold=True)
    if subtitle:
        be.text(W / 2, 46, subtitle, color=MUTED, size=10, anchor="c")
    be.text(W / 2, H - 18,
            "Mealy \u00b7 화살표 = 입력/출력" if fsm.mealy
            else "Moore \u00b7 원 안 = 상태/출력",
            color=MUTED, size=10, anchor="c")

    cx, cy = W / 2, H / 2
    for (a, b), labs in fsm.edges().items():
        lab = ", ".join(sorted(set(labs)))
        q0, q1 = pos[a], pos[b]
        if a == b:                                   # 제자리로 돌아오는 화살표
            ang = (math.atan2(q0[1] - cy, q0[0] - cx) if len(pos) > 1
                   else -math.pi / 2)
            s1 = (q0[0] + NODE_R * math.cos(ang - 0.5),
                  q0[1] + NODE_R * math.sin(ang - 0.5))
            s2 = (q0[0] + NODE_R * math.cos(ang + 0.5),
                  q0[1] + NODE_R * math.sin(ang + 0.5))
            c1 = (q0[0] + 2.9 * NODE_R * math.cos(ang - 0.55),
                  q0[1] + 2.9 * NODE_R * math.sin(ang - 0.55))
            c2 = (q0[0] + 2.9 * NODE_R * math.cos(ang + 0.55),
                  q0[1] + 2.9 * NODE_R * math.sin(ang + 0.55))
            pts = cbez(s1, c1, c2, s2)
            lx = q0[0] + 2.6 * NODE_R * math.cos(ang)
            ly = q0[1] + 2.6 * NODE_R * math.sin(ang)
        else:
            dx, dy = q1[0] - q0[0], q1[1] - q0[1]
            d = math.hypot(dx, dy) or 1
            ux, uy = dx / d, dy / d
            off = 0.18 * d
            mid = ((q0[0] + q1[0]) / 2 - uy * off, (q0[1] + q1[1]) / 2 + ux * off)
            dp = math.hypot(mid[0] - q0[0], mid[1] - q0[1]) or 1
            e0 = (q0[0] + NODE_R * (mid[0] - q0[0]) / dp,
                  q0[1] + NODE_R * (mid[1] - q0[1]) / dp)
            dq = math.hypot(mid[0] - q1[0], mid[1] - q1[1]) or 1
            e1 = (q1[0] + NODE_R * (mid[0] - q1[0]) / dq,
                  q1[1] + NODE_R * (mid[1] - q1[1]) / dq)
            pts = qbez(e0, mid, e1)
            lx = (e0[0] + 2 * mid[0] + e1[0]) / 4
            ly = (e0[1] + 2 * mid[1] + e1[1]) / 4

        dim = a not in fsm.reach
        be.polyline(pts, color=GHOST if dim else INK, width=1.6)
        be.polygon(arrow_head(pts), fill=GHOST if dim else INK)
        if lab:
            w = 6.8 * len(lab) + 8
            be.rect(lx - w / 2, ly - 9, lx + w / 2, ly + 9, fill=PAPER)
            be.text(lx, ly, lab, color=MUTED if dim else ACCENT,
                    size=11, anchor="c", bold=True)

    for q, (x, y) in pos.items():
        on = q in fsm.reach
        if q == fsm.start:
            be.polyline([(x - NODE_R - 34, y), (x - NODE_R - 6, y)],
                        color=ACCENT, width=2)
            be.polygon(arrow_head([(x - NODE_R - 34, y), (x - NODE_R - 5, y)]),
                       fill=ACCENT)
        be.ellipse(x - NODE_R, y - NODE_R, x + NODE_R, y + NODE_R,
                   fill=SOFT if on else PAPER, outline=INK if on else GHOST,
                   width=2, dash=None if on else (3, 3))
        be.text(x, y, fsm.node_label(q), color=INK if on else GHOST,
                size=12, anchor="c", bold=True)


def render_graph_png(fsm, path, title="", subtitle="", k=2):
    W, H = graph_size(fsm)
    im = Image.new("RGB", (W * k, H * k), PAPER)
    draw_graph(PilBackend(im, k), fsm, W, H, title, subtitle)
    im.save(path)
    return path


