    # ── 헬퍼 ──
    def _set(self, key, val):
        setattr(self.st, key, val)
        self.redraw()

    def on_steps(self):
        try:
            v = int(self.v_steps.get())
        except Exception:
            return
        self.st.steps = max(2, min(400, v))
        for s in self.st.signals:
            if len(s["values"]) < self.st.steps:
                s["values"].extend([0] * (self.st.steps - len(s["values"])))
            for lb in list(s["labels"]):
                if lb["s"] >= self.st.steps:
                    s["labels"].remove(lb)
                else:
                    lb["e"] = min(lb["e"], self.st.steps - 1)
        self.redraw()

    def sel(self):
        s = self.listbox.curselection()
        if not s or s[0] >= len(self.rowmap):
            return None
        return self.rowmap[s[0]]

    def refresh_list(self, keep=None):
        self.listbox.delete(0, "end")
        self.rowmap = []
        last = None
        for i, sg in enumerate(self.st.signals):
            g = sg.get("group", "")
            if g != last:                       # 회로가 바뀌면 제목 줄
                last = g
                if g:
                    self.listbox.insert("end", g)
                    self.listbox.itemconfig("end", foreground=ACCENT)
                    self.rowmap.append(None)
            mark = {"clk": "CLK", "eq": " = ", "seq": " FF"}.get(sg["type"], "   ")
            self.listbox.insert("end", "%s%s  %s" % ("    " if g else " ",
                                                     mark, sg["name"]))
            self.rowmap.append(i)
        if self.st.signals:
            i = 0 if keep is None else min(keep, len(self.st.signals) - 1)
            self.pick_line(i)

    def pick_line(self, node):
        """노드 번호로 목록 줄을 고릅니다."""
        if node is None or node not in self.rowmap:
            return
        line = self.rowmap.index(node)
        self.listbox.selection_clear(0, "end")
        self.listbox.selection_set(line)
        self.listbox.see(line)
        self.load_form()

    def on_list_pick(self):
        """회로 제목 줄을 누르면 그 회로의 첫 노드로 옮깁니다."""
        cur = self.listbox.curselection()
        if cur and self.rowmap[cur[0]] is None:
            nxt = next((k for k in range(cur[0] + 1, len(self.rowmap))
                        if self.rowmap[k] is not None), None)
            if nxt is not None:
                self.listbox.selection_clear(0, "end")
                self.listbox.selection_set(nxt)
        self.load_form()

    def load_form(self):
        i = self.sel()
        if i is None:
            return
        s = self.st.signals[i]
        self.v_name.set(s["name"])
        self.v_type.set(s["type"])
        self.v_period.set(s.get("period", 2))
        self.v_phase.set(int(s.get("phase", 0)))
        self.v_inv.set(bool(s.get("inv")))
        self.v_expr.set(s.get("expr", ""))
        self.v_group.set(s.get("group", ""))
        self.cb_group.configure(values=[q for q in self.st.group_names() if q])
        mine = s.get("group", "")
        self.cb_src.configure(values=[x["name"] for x in self.st.signals
                                      if x is not s
                                      and x.get("group", "") == mine])
        ck = self.st.clock_of(s) if s.get("type") == "seq" else None
        self.v_src.set(ck["name"] if ck else s.get("clk", ""))
        self.v_edge.set(s.get("edge", "rise"))
        self.v_init.set(1 if s.get("init") else 0)
        self.show_eq_status()
        self.sync_fsm_groups(s.get("group", ""))
        self.refresh_fsm()          # 고른 회로에 맞춰 천이도도 바꿉니다

    def show_eq_status(self):
        """식 노드의 상태(오류 / ? 안내)를 폼에 보여 줍니다."""
        i = self.sel()
        if i is None:
            return
        s = self.st.signals[i]
        if s.get("type") not in ("eq", "seq"):
            self.lbl_eq.configure(
                foreground=MUTED,
                text="식을 쓰고 [식 적용]을 누르면 조합식 노드가 됩니다")
            return
        msg = self.st.eq_error(s)
        bad = msg.startswith(("모르는", "클럭", "정보가", "식이", "읽을", "예상", "알 수"))
        self.lbl_eq.configure(foreground=(UNKNOWN if bad else ACCENT), text=msg)

    def apply_seq(self):
        i = self.sel()
        if i is None:
            return
        s = self.st.signals[i]
        s["clk"] = self.v_src.get()
        s["edge"] = self.v_edge.get()
        s["init"] = int(self.v_init.get())
        self.redraw()
        self.show_eq_status()

    def apply_expr(self):
        i = self.sel()
        if i is None:
            return
        s = self.st.signals[i]
        s["expr"] = self.v_expr.get().strip()
        if s["type"] not in ("eq", "seq"):       # 순차식은 순차식으로 둡니다
            if not s["expr"]:
                return
            s["type"] = "eq"
            self.v_type.set("eq")
            self.refresh_list(i)
        self.redraw()
        self.show_eq_status()

    # ── 노드 편집 ──
    def add_node(self):
        n = sum(1 for s in self.st.signals if s["type"] == "sig") + 1
        i = self.sel()
        at = len(self.st.signals) if i is None else i + 1
        self.st.signals.insert(at, dict(
            name="node%d" % n, type="sig", period=2, inv=False, expr="",
            clk="", edge="rise", init=0, group=self._group_at(i),
            values=[0] * self.st.steps, labels=[]))
        self.refresh_list(at)
        self.redraw()

    def _group_at(self, i):
        return "" if i is None else self.st.signals[i].get("group", "")

    def del_node(self):
        i = self.sel()
        if i is None or len(self.st.signals) <= 1:
            return
        self.st.signals.pop(i)
        self.v_clk.set(any(s["type"] == "clk" for s in self.st.signals))
        self.refresh_list(i)
        self.redraw()

    def move(self, d):
        i = self.sel()
        return None if i is None else self.move_row(i, d)

    def move_row(self, i, d):
        """i번 줄을 d칸(위 -1 / 아래 +1) 옮깁니다."""
        j = i + d
        if not (0 <= i < len(self.st.signals)) or not (0 <= j < len(self.st.signals)):
            return "break"
        self.close_editor(save=True)
        sg = self.st.signals
        sg[i], sg[j] = sg[j], sg[i]
        if self.hot_row in (i, j):
            self.hot_row = j                 # 손잡이가 옮긴 줄을 따라갑니다
        self.refresh_list(j)
        self.redraw()
        return "break"

    def apply_name(self):
        i = self.sel()
        if i is None:
            return
        self.st.rename(i, self.v_name.get())
        self.refresh_list(i)
        self.redraw()

    def apply_group(self):
        """고른 노드를 그 이름의 회로에 넣습니다(비우면 회로 나눔 없음)."""
        i = self.sel()
        if i is None:
            return
        self.st.signals[i]["group"] = self.v_group.get().strip()[:16]
        self.refresh_list(i)
        self.redraw()

    def apply_type(self):
        i = self.sel()
        if i is None:
            return
        sig = self.st.signals[i]
        sig["type"] = self.v_type.get()
        if sig["type"] == "seq" and not sig.get("clk"):
            ck = self.st.clock_of(sig)
            sig["clk"] = ck["name"] if ck else ""
            sig.setdefault("edge", "rise")
            sig.setdefault("init", 0)
        self.v_clk.set(any(s["type"] == "clk" for s in self.st.signals))
        self.refresh_list(i)
        self.redraw()
        self.show_eq_status()

    def apply_period(self):
        i = self.sel()
        if i is not None:
            self.st.signals[i]["period"] = max(2, int(self.v_period.get()))
            self.st.invalidate()
            self.redraw()

    def apply_eline(self):
        self.st.edge_line = ELINE_KEY.get(self.v_eline.get(), "")
        self.redraw()

    def apply_phase(self):
        i = self.sel()
        if i is None:
            return
        try:
            self.st.signals[i]["phase"] = max(0, int(self.v_phase.get()))
        except Exception:
            return
        self.st.invalidate()
        self.redraw()

    def apply_inv(self):
        i = self.sel()
        if i is not None:
            self.st.signals[i]["inv"] = self.v_inv.get()
            self.st.invalidate()
            self.redraw()

    def fill(self, v):
        i = self.sel()
        if i is None:
            return
        if self.st.signals[i]["type"] != "sig":
            return
        self.st.signals[i]["values"] = [v] * self.st.steps
        self.redraw()

    def invert(self):
        i = self.sel()
        if i is None:
            return
        s = self.st.signals[i]
        if s["type"] != "sig":
            return
        s["values"] = [1 - self.st.val(s, k) for k in range(self.st.steps)]
        self.redraw()

    def clear_labels(self):
        i = self.sel()
        if i is None:
            return
        self.st.signals[i]["labels"] = []
        self.redraw()

    def toggle_clock(self):
        if self.v_clk.get():
            if not any(s["type"] == "clk" for s in self.st.signals):
                self.st.signals.insert(0, dict(name="clock", type="clk", period=2,
                                               inv=False, values=[], labels=[]))
        else:
            self.st.signals = [s for s in self.st.signals if s["type"] != "clk"]
            if not self.st.signals:
                self.add_node()
        self.refresh_list(0)
        self.redraw()

    def _sync_ui(self):
        """상태(State)를 툴바·폼의 위젯 값에 맞춰 둡니다."""
        self.close_editor(save=False)
        self.v_steps.set(self.st.steps)
        self.v_w.set(self.st.cellw)
        self.v_title.set(self.st.title)
        self.v_unit.set(self.st.unit)
        self.v_iscale.set(self.st.img_scale)
        self.v_grid.set(self.st.show_grid)
        self.v_vals.set(self.st.show_values)
        self.v_eline.set(next((t for t, k in ELINE_KEY.items()
                               if k == self.st.edge_line), ELINE_TEXT[0]))
        self.v_clk.set(any(s["type"] == "clk" for s in self.st.signals))
        self.tk_img = None
        self.refresh_list(0)
        self.redraw()

    def reset(self):
        """예제 다이어그램으로 되돌립니다."""
        self.st = State()
        self.file_path = ""
        self._sync_ui()

    def reset_seq(self):
        """순차 회로 예제(입력 X · 상태 A · 출력 Z/Y)를 불러옵니다."""
        self.st = State()
        self.st.seed_seq()
        self.file_path = ""
        self._sync_ui()

    def reset_all(self):
        """모든 내용을 지우고 빈 문서에서 다시 시작합니다."""
        if not messagebox.askyesno(
                "초기화", "지금 내용을 모두 지우고 처음부터 시작할까요?", parent=self):
            return
        self.st = State()
        self.st.blank()
        self.file_path = ""
        self.mode.set("draw")
        self._sync_ui()

    # ── 마우스 ──
    def locate(self, ev):
        x = self.canvas.canvasx(ev.x)
        y = self.canvas.canvasy(ev.y)
        i = int((x - self.st.chart_x) // self.st.cellw)
        r = self.st.row_at(y)
        if not (0 <= i < self.st.steps) or r is None:
            return None, None
        return r, i

    def gutter_row(self, ev):
        """왼쪽 여백에서 마우스가 얹힌 줄."""
        x = self.canvas.canvasx(ev.x)
        y = self.canvas.canvasy(ev.y)
        if x >= self.st.chart_x:
            return None
        return self.st.row_at(y)

    def handle_hit(self, ev):
        """▲▼ 손잡이를 눌렀는지 봅니다 -> (줄, 방향)."""
        x = self.canvas.canvasx(ev.x)
        y = self.canvas.canvasy(ev.y)
        for r in {q for q in (self.sel(), self.hot_row) if q is not None}:
            if not (0 <= r < len(self.st.signals)):
                continue
            for box, d in zip(handle_boxes(self.st, r), (-1, 1)):
                if in_box(box, x, y):
                    return r, d
        return None

    def select_row(self, r):
        if r is None or self.sel() == r:
            return
        self.pick_line(r)
        self.draw_tools()

    def draw_tools(self):
        self.canvas.delete("tools")
        draw_row_tools(TkBackend(self.canvas, "tools"), self.st,
                       sel=self.sel(), hot=self.hot_row)

    def name_hit(self, ev):
        """왼쪽 이름 글씨를 눌렀는지 봅니다. 눌렀으면 그 줄 번호."""
        x = self.canvas.canvasx(ev.x)
        y = self.canvas.canvasy(ev.y)
        if not (PAD - 12 <= x < self.st.chart_x - 8):
            return None
        r = self.st.row_at(y)
        if r is None:
            return None
        if abs(y - self.st.y_mid(r)) > 12:        # 이름 줄만(식 줄은 빼고)
            return None
        return r

    def edit_name(self, r):
        """차트의 이름 자리에 입력칸을 올려 그 자리에서 고칩니다."""
        self.close_editor(save=True)
        x2 = self.st.chart_x - 28
        x1 = max(2, x2 - 98)
        wx = x1 - self.canvas.canvasx(0)
        wy = self.st.y_mid(r) - 11 - self.canvas.canvasy(0)
        var = tk.StringVar(value=self.st.signals[r]["name"])
        e = tk.Entry(self.canvas, textvariable=var, justify="right",
                     font=(MONO, 11, "bold"), fg=INK, relief="solid", bd=1,
                     highlightthickness=1, highlightbackground=ACCENT,
                     highlightcolor=ACCENT)
        e.place(x=wx, y=wy, width=x2 - x1, height=22)
        e.focus_set()
        e.select_range(0, "end")
        e.icursor("end")
        self.editor = (e, var, r)
        self.f_off()                       # 이름 칸에서는 F 가 그냥 글자입니다
        e.bind("<Return>", lambda ev: self.close_editor(save=True))
        e.bind("<Escape>", lambda ev: self.close_editor(save=False))
        e.bind("<FocusOut>", lambda ev: self.close_editor(save=True))
        e.bind("<Tab>", lambda ev: self.edit_step(1))
        e.bind("<Shift-Tab>", lambda ev: self.edit_step(-1))
        e.bind("<Down>", lambda ev: self.edit_step(1))
        e.bind("<Up>", lambda ev: self.edit_step(-1))
        e.bind("<Alt-Down>", lambda ev: self.edit_move(1))
        e.bind("<Alt-Up>", lambda ev: self.edit_move(-1))

    def close_editor(self, save=True):
        if not self.editor:
            return "break"
        e, var, r = self.editor
        self.editor = None                 # FocusOut 이 다시 들어오지 않게 먼저 비웁니다
        e.destroy()
        if save and r < len(self.st.signals):
            self.st.rename(r, var.get())
        self.refresh_list(min(r, len(self.st.signals) - 1))
        self.redraw()
        return "break"

    def edit_move(self, d):
        """이름을 고치는 중에 그 줄을 위아래로 옮깁니다."""
        if not self.editor:
            return "break"
        r = self.editor[2]
        j = r + d
        if not (0 <= j < len(self.st.signals)):
            return "break"
        self.move_row(r, d)        # 여기서 이름이 저장되고 편집칸이 닫힙니다
        self.edit_name(j)
        return "break"

    def edit_step(self, d):
        """Tab / 화살표로 옆 줄 이름으로 넘어갑니다."""
        if not self.editor:
            return "break"
        r = (self.editor[2] + d) % len(self.st.signals)
        self.close_editor(save=True)
        self.edit_name(r)
        return "break"

    def set_cursor(self, i):
        self.st.cursor = i
        self.canvas.delete("cursor")
        if i is not None:
            draw_cursor(TkBackend(self.canvas, "cursor"), self.st)

    def on_hover(self, ev):
        hot = self.gutter_row(ev)
        if hot != self.hot_row:
            self.hot_row = hot
            self.draw_tools()
        r, i = self.locate(ev)
        self.hover_rc = (r, i)
        if self.f_on() and r is not None:
            shape = "dotbox"
        elif self.handle_hit(ev):
            shape = "hand2"
        elif self.name_hit(ev) is not None:
            shape = "xterm"
        else:
            shape = ""
        self.canvas.configure(cursor=shape)
        if i != self.st.cursor:
            self.set_cursor(i)

    def on_leave(self, ev):
        self.set_cursor(None)
        self.hover_rc = (None, None)
        if self.hot_row is not None:
            self.hot_row = None
            self.draw_tools()

    def on_down(self, ev):
        hit = self.handle_hit(ev)
        if hit:
            self.canvas.focus_set()
            return self.move_row(*hit)
        nr = self.name_hit(ev)
        if nr is not None:
            self.select_row(nr)
            self.edit_name(nr)
            return
        self.close_editor(save=True)
        self.canvas.focus_set()          # 이제 ↑↓ 키로 줄을 옮길 수 있습니다
        r, i = self.locate(ev)
        if r is None:
            return
        self.select_row(r)
        if self.mode.get() == "draw":
            sig = self.st.signals[r]
            if sig["type"] != "sig":          # 클럭·상태식은 손으로 못 바꿉니다
                return
            if self.f_on():
                v = FALSE
                if self.f_hold:
                    self.f_used = True       # 누른 채 찍었으니 모드를 켜지 않습니다
            else:
                v = 0 if self.st.val(sig, i) else 1
            self.drag = ("draw", r, v)
            self.st.set_val(r, i, v)
            self.redraw()
        else:
            self.drag = ("label", r, i)
            self.preview = (r, i, i)
            self.redraw()

    def on_move(self, ev):
        if not self.drag:
            return
        r, i = self.locate(ev)
        if i is None:
            return
        kind = self.drag[0]
        if kind == "draw":
            self.st.set_val(self.drag[1], i, self.drag[2])
        else:
            r0, s0 = self.drag[1], self.drag[2]
            self.preview = (r0, min(s0, i), max(s0, i))
        self.redraw()
        self.set_cursor(i)

    def on_up(self, ev):
        if self.drag and self.drag[0] == "label" and self.preview:
            r, s, e = self.preview
            sig = self.st.signals[r]
            hit = next((lb for lb in sig["labels"]
                        if s == e and lb["s"] <= s <= lb["e"]), None)
            if hit:
                txt = simpledialog.askstring("구간 이름", "이름 (비우면 삭제):",
                                             initialvalue=hit["text"], parent=self)
                if txt is not None:
                    if txt.strip():
                        hit["text"] = txt.strip()
                    else:
                        sig["labels"].remove(hit)
            else:
                txt = simpledialog.askstring(
                    "구간 이름", "t=%d ~ %d 구간 이름:" % (s, e), parent=self)
                if txt and txt.strip():
                    sig["labels"].append(dict(s=s, e=e, text=txt.strip()))
        self.drag = None
        self.preview = None
        self.redraw()

    # ── 이미지 ──
    def pick_image(self):
        types = [("이미지", "*.png *.gif *.jpg *.jpeg *.bmp")] if HAS_PIL \
            else [("PNG / GIF", "*.png *.gif")]
        path = filedialog.askopenfilename(title="회로도 이미지 선택", filetypes=types)
        if not path:
            return
        self.load_image(path)

    def load_image(self, path):
        try:
            if HAS_PIL:
                self.st.img = Image.open(path).convert("RGB")
            else:
                self.st.img = tk.PhotoImage(file=path)
            self.st.img_path = path
            self.redraw()
        except Exception as ex:
            messagebox.showerror(
                "이미지를 열 수 없습니다",
                "%s\n\nPillow가 없으면 PNG와 GIF만 열립니다.\n"
                "터미널에서 pip install pillow 를 실행해 보세요." % ex)

    def clear_image(self):
        self.st.img = None
        self.st.img_path = ""
        self.tk_img = None
        self.redraw()

    def _prep_tk_image(self):
        if self.st.img is None:
            self.tk_img = None
            return
        w, h = self.st.img_box()
        if HAS_PIL:
            self.tk_img = ImageTk.PhotoImage(self.st.img.resize((max(1, w), max(1, h))))
        else:
            src = self.st.img
            f = max(1, round(src.width() / max(1, w)))
            self.tk_img = src.subsample(f, f)

    # ── 파일 ──
    def save_json(self):
        p = filedialog.asksaveasfilename(defaultextension=".json",
                                         filetypes=[("타이밍 파일", "*.json")])
        if not p:
            return
        with open(p, "w", encoding="utf-8") as f:
            json.dump(self.st.to_dict(), f, ensure_ascii=False, indent=1)
        self.file_path = p

    def open_json(self):
        p = filedialog.askopenfilename(filetypes=[("타이밍 파일", "*.json")])
        if not p:
            return
        with open(p, encoding="utf-8") as f:
            self.st.from_dict(json.load(f))
        self.st.img = None
        if self.st.img_path and os.path.exists(self.st.img_path):
            self.load_image(self.st.img_path)
        self.file_path = p
        self._sync_ui()

    def export_png(self):
        if self.tab() == 2:
            return self.export_table()
        if not HAS_PIL:
            messagebox.showinfo(
                "Pillow가 필요합니다",
                "PNG로 저장하려면 Pillow를 설치해 주세요.\n\n    pip install pillow")
            return
        graph = self.tab() == 1
        if graph:
            fsm, err = self.build_fsm()
            if fsm is None:
                messagebox.showerror("상태 천이도를 만들 수 없습니다", err)
                return
        base = (self.st.title or "timing").replace(" ", "_")
        p = filedialog.asksaveasfilename(
            defaultextension=".png", filetypes=[("PNG 이미지", "*.png")],
            initialfile=base + ("_graph.png" if graph else ".png"))
        if not p:
            return
        if graph:
            render_graph_png(fsm, p, self.st.title, fsm.summary())
        else:
            render_png(self.st, p)
        messagebox.showinfo("저장 완료", "PNG로 저장했습니다.\n%s" % p)

    def export_table(self):
        """상태표를 글자 파일로 저장합니다."""
        fsm, err = self.build_fsm()
        if fsm is None:
            messagebox.showerror("상태표를 만들 수 없습니다", err)
            return
        p = filedialog.asksaveasfilename(
            defaultextension=".txt", filetypes=[("글자 파일", "*.txt")],
            initialfile=(self.st.title or "timing").replace(" ", "_") + "_table.txt")
        if not p:
            return
        with open(p, "w", encoding="utf-8") as f:
            f.write(fsm.table_text())
        messagebox.showinfo("저장 완료", "상태표를 저장했습니다.\n%s" % p)

    # ── 다시 그리기 ──
    def redraw(self):
        self._prep_tk_image()
        self.canvas.delete("all")
        draw_scene(TkBackend(self.canvas), self.st, tk_img=self.tk_img,
                   preview=self.preview)
        self.canvas.configure(scrollregion=(0, 0, self.st.total_w, self.st.total_h))
        self.draw_tools()
        if self.st.cursor is not None:
            draw_cursor(TkBackend(self.canvas, "cursor"), self.st)
        self.refresh_fsm()


def render_png(st, path, scale=2):
    im = Image.new("RGB", (int(st.total_w * scale), int(st.total_h * scale)), PAPER)
    be = PilBackend(im, scale)
    draw_scene(be, st, tk_img=None, with_cursor=False)
    im.save(path)
    return path


