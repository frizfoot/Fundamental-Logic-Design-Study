    def sync_fsm_groups(self, want=None):
        """고를 수 있는 회로 목록을 맞춰 둡니다."""
        show = [g or self.NO_GROUP for g in self.st.group_names()]
        for cb in self._fsm_cbs:
            cb.configure(values=show)
        if want is not None:
            want = want or self.NO_GROUP
        cur = want if want in show else self.v_fsm_group.get()
        if cur not in show:
            cur = show[0] if show else ""
        if cur != self.v_fsm_group.get():
            self.v_fsm_group.set(cur)

    def tab(self):
        try:
            return self.nb.index(self.nb.select())
        except Exception:
            return 0

    def build_fsm(self):
        """고른 회로로 상태 기계를 만듭니다. 안 되면 (None, 까닭)."""
        try:
            return Fsm(self.st, self.fsm_group()), ""
        except FsmError as ex:
            return None, str(ex)
        except Exception as ex:
            return None, "상태 기계를 만들지 못했습니다: %s" % ex

    def refresh_fsm(self):
        """탭이 열려 있을 때만 천이도·상태표를 다시 만듭니다."""
        if self.tab() == 0 or not hasattr(self, "table"):
            return
        self.sync_fsm_groups()
        self.gcanvas.delete("all")
        self.table.delete("1.0", "end")
        self.fsm, err = self.build_fsm()
        if self.fsm is None:
            self.gcanvas.create_text(24, 24, text="⚠ %s" % err, anchor="nw",
                                     fill=UNKNOWN, font=(MONO, 11))
            self.table.insert("1.0", "⚠ %s\n\n%s" % (err, FSM_HELP))
            return
        w, h = graph_size(self.fsm)
        draw_graph(TkBackend(self.gcanvas), self.fsm, w, h,
                   self.st.title, self.fsm.summary())
        self.gcanvas.configure(scrollregion=(0, 0, w, h))
        self.table.insert("1.0", self.fsm.table_text())

    # ── 단축키 안내줄 ──
    def _build_status(self):
        box = ttk.Frame(self, padding=(12, 4))
        box.pack(fill="x", padx=10, pady=(4, 0))
        self.lbl_keys = ttk.Label(box, font=(MONO, 9), foreground=MUTED,
                                  text=KEY_HINT)
        self.lbl_keys.pack(anchor="w")
        ttk.Label(box, font=(MONO, 9), foreground=MUTED,
                  text=EQ_HINT).pack(anchor="w")

    def show_keys(self):
        if self.f_on():
            self.lbl_keys.configure(text=KEY_HINT_F, foreground=ACCENT)
        else:
            self.lbl_keys.configure(text=KEY_HINT, foreground=MUTED)

    # ── F 키 ──
    def _is_typing(self):
        """글자를 넣는 칸에 커서가 있으면 F 를 단축키로 쓰지 않습니다."""
        return isinstance(self.focus_get(), (tk.Entry, tk.Spinbox, tk.Text))

    def f_on(self):
        """지금 클릭하면 F 가 들어가는 상태인지."""
        return self.f_hold or self.f_sticky

    def _is_f(self, ev):
        """자판이 한글이어도 F 키를 알아봅니다."""
        return (ev.keysym or "").lower() == "f" or ev.keycode == 70

    def on_key_down(self, ev):
        if not self._is_f(ev) or self._is_typing():
            return
        self.f_hold = True
        self.show_keys()

    def on_key_up(self, ev):
        if not self._is_f(ev) or self._is_typing():
            return
        self.f_hold = False
        if not self.f_used:          # 누른 채 찍지 않았으면 모드를 켜고 끕니다
            self.f_sticky = not self.f_sticky
        self.f_used = False
        self.show_keys()

    def f_off(self):
        if self.f_sticky or self.f_hold:
            self.f_sticky = self.f_hold = False
            self.show_keys()

